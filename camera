#shutter{width:70px;height:70px;border-radius:50%;border:3px solid #fff;cursor:pointer;background:transparent;position:relative;flex-shrink:0;transition:transform .1s}
#shutter::after{content:'';position:absolute;inset:5px;border-radius:50%;background:#fff;transition:transform .1s}
