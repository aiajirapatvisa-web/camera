  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
:root{--g:#c5a059;--gl:#f0d98a;--gd:#7a4d0a;--dark:#04090f;--navy:#080f1e}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{font-family:'Prompt',sans-serif;background:var(--dark);color:#fff;height:100dvh;overflow:hidden;-webkit-font-smoothing:antialiased}

/* video */
#vid{position:fixed;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;background:#111}
#vid.mirror{transform:scaleX(-1)}

/* gold btn */
.btn-gold{background:linear-gradient(90deg,var(--gd),var(--gl),var(--g),var(--gl),var(--gd));background-size:300% auto;animation:shine 2.5s linear infinite;color:var(--dark);font-weight:700;font-family:'Prompt',sans-serif;border:none;cursor:pointer;text-transform:uppercase;letter-spacing:.08em;border-radius:16px;font-size:14px;padding:15px 32px;width:100%;max-width:290px;transition:transform .12s}
.btn-gold:active{transform:scale(.96)}
.btn-gold:disabled{animation:none;background:#1c1c1c;color:#333;cursor:not-allowed}
@keyframes shine{to{background-position:300% center}}

/* screens */
.scr{position:fixed;inset:0;z-index:200;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:28px 24px;text-align:center;background:linear-gradient(145deg,#030810,var(--dark))}
.scr.hide{display:none}

/* rings */
.rings{position:relative;width:76px;height:76px;margin:0 auto 4px}
.ra,.rb{position:absolute;border-radius:50%;border:1px solid rgba(197,160,89,.18)}
.ra{inset:0;animation:pr 2.4s ease-in-out infinite}
.rb{inset:12px;animation:pr 2.4s ease-in-out .4s infinite}
.rc{position:absolute;inset:24px;border-radius:50%;border:1px solid rgba(197,160,89,.5);background:rgba(197,160,89,.06);display:flex;align-items:center;justify-content:center}
@keyframes pr{0%,100%{transform:scale(1);opacity:.5}50%{transform:scale(1.1);opacity:.12}}
@keyframes spin{to{transform:rotate(360deg)}}
.spinner{width:34px;height:34px;border-radius:50%;border:2px solid rgba(197,160,89,.12);border-top-color:var(--g);animation:spin .7s linear infinite}

.ey{font-size:8px;color:rgba(197,160,89,.35);letter-spacing:.45em;text-transform:uppercase}
.scr h2{font-size:17px;font-weight:700;color:#fff}
.scr .sub{font-size:12px;color:rgba(255,255,255,.32);line-height:1.75;max-width:260px}

/* denied screen */
.icon-deny{width:62px;height:62px;border-radius:50%;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.28);display:flex;align-items:center;justify-content:center;margin:0 auto 4px}
.steps{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:16px 18px;width:100%;max-width:320px;text-align:left}
.sr{display:flex;gap:10px;align-items:flex-start;margin-bottom:10px}
.sr:last-child{margin-bottom:0}
.sn{width:22px;height:22px;border-radius:50%;flex-shrink:0;background:rgba(197,160,89,.14);border:1px solid rgba(197,160,89,.28);font-size:10px;font-weight:700;color:var(--g);display:flex;align-items:center;justify-content:center;margin-top:1px}
.st{font-size:11px;color:rgba(255,255,255,.5);line-height:1.65}
.st b{color:rgba(197,160,89,.85)}
.key{display:inline-block;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:4px;padding:1px 6px;font-size:10px;font-family:monospace;color:#fff}
.btn-retry{background:rgba(197,160,89,.1);border:1px solid rgba(197,160,89,.28);color:var(--g);font-family:'Prompt',sans-serif;font-weight:600;font-size:12px;padding:10px 24px;border-radius:12px;cursor:pointer;text-transform:uppercase;letter-spacing:.06em;width:100%;max-width:290px;transition:background .2s}
.btn-retry:hover{background:rgba(197,160,89,.18)}

/* camera modal */
#modal{position:fixed;inset:0;z-index:400;background:rgba(0,0,0,.88);display:none;flex-direction:column;align-items:center;justify-content:center;padding:20px}
#modal.show{display:flex}
