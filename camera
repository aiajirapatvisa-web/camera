<script>
/* STATE */
let stream=null, facing='user', ratio='916', selectedId=null, allDevs=[], captured=null;
const VIRT=['camo','reincubate','obs','manycam','droidcam','snap camera','epoccam','ivcam','xsplit','splitcam','ndi','virtual','vcam','elgato','mmhmm'];
const isVirt=l=>VIRT.some(k=>l.toLowerCase().includes(k));

/* SHOW SCREEN */
function show(id){['scrCheck','scrPrompt','scrDenied'].forEach(s=>{const el=document.getElementById(s);if(el)el.className='scr'+(s!==id?' hide':'')});}

/* ════════════════════════════════
   INIT — check permission state
════════════════════════════════ */
window.addEventListener('load',async()=>{
  try{
    if(navigator.permissions){
      const p=await navigator.permissions.query({name:'camera'});
      if(p.state==='granted'){show('scrCheck');await grantedFlow();return;}
      if(p.state==='denied'){show('scrDenied');return;}
      show('scrPrompt');
      p.onchange=()=>{
        if(p.state==='granted'){show('scrCheck');grantedFlow();}
        else if(p.state==='denied')show('scrDenied');
        else show('scrPrompt');
      };
    }else{show('scrPrompt');}
  }catch(e){show('scrPrompt');}
});

/* ════════════════════════════════
   GRANTED FLOW
════════════════════════════════ */
async function grantedFlow(){
  try{
    const tmp=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
    tmp.getTracks().forEach(t=>t.stop());
    const d=await navigator.mediaDevices.enumerateDevices();
    allDevs=d.filter(x=>x.kind==='videoinput');
    buildList();
    document.getElementById('modal').classList.add('show');
    show('scrCheck'); document.getElementById('scrCheck').className='scr hide';
  }catch(e){handleErr(e,'promptErr');show('scrPrompt');}
}

/* ════════════════════════════════
   REQUEST CAMERA — USER GESTURE
   ❗ ต้องเรียกจาก onclick โดยตรง
════════════════════════════════ */
async function doRequestCamera(){
  const errEl=document.getElementById('promptErr');
  const btn=document.getElementById('btnPrompt');
  if(btn){btn.disabled=true;btn.textContent='⏳ กำลังขอสิทธิ์...';}
  if(errEl)errEl.style.display='none';
  try{
    const tmp=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
    tmp.getTracks().forEach(t=>t.stop());
    const d=await navigator.mediaDevices.enumerateDevices();
    allDevs=d.filter(x=>x.kind==='videoinput');
    if(btn){btn.disabled=false;btn.textContent='🎥  เลือกกล้อง';}
    buildList();
    document.getElementById('modal').classList.add('show');
    show('scrCheck'); document.getElementById('scrCheck').className='scr hide';
  }catch(e){
    if(btn){btn.disabled=false;btn.textContent='🎥  เลือกกล้อง';}
    if(e.name==='NotAllowedError'||e.name==='PermissionDeniedError'){show('scrDenied');}
    else{if(errEl){errEl.textContent=errMsg(e);errEl.style.display='block';}}
  }
}

async function retryPermission(){
  show('scrCheck');
  try{
    const p=await navigator.permissions.query({name:'camera'});
    if(p.state==='denied'){show('scrDenied');showBadge('⚠ ยังบล็อกอยู่ ทำตามขั้นตอนอีกครั้ง','',3000);}
    else await grantedFlow();
  }catch(e){show('scrPrompt');}
}

/* BUILD LIST */
function buildList(){
  const list=document.getElementById('camList');
  list.innerHTML='';
  if(!allDevs.length){list.innerHTML='<p style="font-size:11px;color:rgba(255,255,255,.3);text-align:center;padding:16px 0">ไม่พบกล้อง<br>เปิด Camo หรือเสียบกล้องก่อน</p>';return;}
  const sorted=[...allDevs].sort((a,b)=>isVirt(a.label||'')&&!isVirt(b.label||'')?-1:!isVirt(a.label||'')&&isVirt(b.label||'')?1:0);
  sorted.forEach((d,i)=>{
    const lbl=d.label||`Camera ${i+1}`;
    const virt=isVirt(lbl);
    const item=document.createElement('div');
    item.className='ci'+(i===0?' sel':'');
    item.dataset.id=d.deviceId;
    if(i===0)selectedId=d.deviceId;
    item.innerHTML=`
      <div class="ci-ico">
        ${virt?`<svg width="14" height="14" fill="none" stroke="#c5a059" stroke-width="1.5" viewBox="0 0 24 24"><rect x="2" y="7" width="15" height="10" rx="2"/><path d="M17 9l4-2v10l-4-2"/></svg>`
              :`<svg width="14" height="14" fill="none" stroke="#c5a059" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><circle cx="12" cy="13" r="3"/></svg>`}
      </div>
      <div class="ci-inf">
        <div class="ci-nm">${lbl}</div>
        <div class="ci-tp">${virt?'⭐ Virtual / Camo / OBS':'Physical Camera'}</div>
      </div>
      ${i===0?'<div class="sel-dot"></div>':''}`;
    item.onclick=()=>{
      document.querySelectorAll('.ci').forEach(el=>{el.classList.remove('sel');const dot=el.querySelector('.sel-dot');if(dot)dot.remove();});
      item.classList.add('sel');
      const dot=document.createElement('div');dot.className='sel-dot';item.appendChild(dot);
      selectedId=d.deviceId;document.getElementById('btnOK').disabled=false;
    };
    list.appendChild(item);
  });
  document.getElementById('btnOK').disabled=false;
}

function closeModal(){
  document.getElementById('modal').classList.remove('show');
  if(!stream)show('scrPrompt');
}

async function openSelectedCam(){
  const errEl=document.getElementById('modalErr');
  const btnOK=document.getElementById('btnOK');
  errEl.style.display='none';btnOK.disabled=true;btnOK.textContent='⏳ กำลังเปิด...';
  try{
    if(stream){stream.getTracks().forEach(t=>t.stop());stream=null;}
    stream=await navigator.mediaDevices.getUserMedia({
      video:{deviceId:selectedId?{exact:selectedId}:undefined,width:{ideal:1920},height:{ideal:1080},frameRate:{ideal:30}},
      audio:false
    });
    const vid=document.getElementById('vid');vid.srcObject=stream;await vid.play();
    const selDev=allDevs.find(d=>d.deviceId===selectedId);
    const lbl=((selDev?selDev.label:'')||'').toLowerCase();
    const front=lbl.includes('front')||lbl.includes('user')||lbl.includes('facetime')||lbl.includes('built-in');
    facing=front?'user':'environment';vid.className=front?'mirror':'';
    document.getElementById('modal').classList.remove('show');
    document.getElementById('camUI').classList.add('show');
    btnOK.disabled=false;btnOK.textContent='เปิดกล้อง';
  }catch(e){
    btnOK.disabled=false;btnOK.textContent='เปิดกล้อง';
    if(e.name==='NotAllowedError'){document.getElementById('modal').classList.remove('show');show('scrDenied');}
    else{errEl.textContent=errMsg(e);errEl.style.display='block';}
  }
}

async function flipCam(){
  facing=facing==='user'?'environment':'user';
  if(stream){stream.getTracks().forEach(t=>t.stop());stream=null;}
  try{
    stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:facing}},audio:false});
    const vid=document.getElementById('vid');vid.srcObject=stream;await vid.play();vid.className=facing==='user'?'mirror':'';
  }catch(e){}
}

function setRatio(r){
  ratio=r;
  document.getElementById('rb916').className='rb-btn'+(r==='916'?' on':'');
  document.getElementById('rb169').className='rb-btn'+(r==='169'?' on':'');
  document.getElementById('g916').className='guide'+(r==='916'?' show':'');
  document.getElementById('g169').className='guide'+(r==='169'?' show':'');
  const s=document.getElementById('shutter');s.className=r==='916'?'gold':'';
}

function shoot(){
  if(!stream)return;
  const vid=document.getElementById('vid'),cvs=document.getElementById('cvs');
  cvs.width=ratio==='916'?720:1280;cvs.height=ratio==='916'?1280:720;
  const ctx=cvs.getContext('2d'),vw=vid.videoWidth||cvs.width,vh=vid.videoHeight||cvs.height;
  const sc=Math.max(cvs.width/vw,cvs.height/vh),dw=vw*sc,dh=vh*sc,dx=(cvs.width-dw)/2,dy=(cvs.height-dh)/2;
  const m=vid.classList.contains('mirror');
  if(m){ctx.save();ctx.translate(cvs.width,0);ctx.scale(-1,1);}
  ctx.drawImage(vid,dx,dy,dw,dh);
  if(m)ctx.restore();
  captured=cvs.toDataURL('image/jpeg',.90);
  const fl=document.getElementById('flash');fl.style.opacity='1';setTimeout(()=>fl.style.opacity='0',120);
  document.getElementById('prevImg').src=captured;document.getElementById('prev').classList.add('show');
}

function retake(){captured=null;document.getElementById('prev').classList.remove('show');}

function sendPhoto(){
  if(!captured)return;
  document.getElementById('prev').classList.remove('show');
  showBadge('⏳ กำลังส่งรูป...','',0);
  const msg={type:'SIGNATURE_PHOTO',image:captured,ratio:ratio==='916'?'9x16':'16x9',frame:ratio};
  if(window.opener&&!window.opener.closed){window.opener.postMessage(msg,'*');}
  showBadge('✅ ส่งรูปสำเร็จ! ปิดหน้าต่างนี้ได้เลย','ok',0);
  setTimeout(()=>window.close(),2200);
}

function showBadge(msg,type,ms){
  const el=document.getElementById('badge');el.textContent=msg;el.className='show'+(type?' '+type:'');
  if(ms>0)setTimeout(()=>el.classList.remove('show'),ms);
}

function handleErr(e,elId){
  if(e.name==='NotAllowedError'||e.name==='PermissionDeniedError'){show('scrDenied');}
  else{const el=document.getElementById(elId);if(el){el.textContent=errMsg(e);el.style.display='block';}}
}

function errMsg(e){
  if(e.name==='NotFoundError')return '🔌 ไม่พบกล้อง — เปิด Camo หรือเสียบกล้องก่อน';
  if(e.name==='NotReadableError')return '🚫 กล้องถูกใช้งานอยู่ — ปิด Zoom/Teams ก่อน';
  return e.name+': '+e.message;
}

navigator.mediaDevices.addEventListener('devicechange',async()=>{
  if(!stream)return;
  const d=await navigator.mediaDevices.enumerateDevices();
  allDevs=d.filter(x=>x.kind==='videoinput');
});
</script>
