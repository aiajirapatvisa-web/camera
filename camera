.gc{position:absolute;width:16px;height:16px}
.gc-tl{top:-1px;left:-1px;border-top:2px solid var(--g);border-left:2px solid var(--g);border-radius:2px 0 0 0}
.gc-tr{top:-1px;right:-1px;border-top:2px solid var(--g);border-right:2px solid var(--g);border-radius:0 2px 0 0}
